{
  "name": "mc-server-manager-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--use-system-ca\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--use-system-ca\" next build",
    "start": "next start",
    "lint": "eslint .",
    "ncu": "npx npm-check-updates -u && npm install",
