    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "type": "module"
