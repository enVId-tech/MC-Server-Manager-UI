    "update-schema:force": "NODE_ENV=development npx tsx scripts/updateSchema.ts",
    "test:portainer": "tsx scripts/test-portainer.ts",
    "test:deployment": "tsx scripts/test-deployment.ts",
    "test:folder-archiving": "tsx scripts/test-folder-archiving.ts",
    "test:player-detection": "tsx scripts/test-player-detection.ts",
    "monitor:resources": "tsx scripts/resource-monitor.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "extract-zip": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "next": "16.4.6",
    "prismarine-nbt": "^2.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "sass": "^1.108.2",
    "uuid": "^14.0.3",
    "webdav": "^5.11.0",
    "yaml": "^2.9.1"
