# Database Configuration
MONGODB_URI=mongodb://localhost:27017/minecraft-server-creator

# JWT Secret Key (required: the app refuses to authenticate without it)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Console Logging Configuration
# Set to 'true' to enable console logs in production, 'false' or omit to disable
ENABLE_CONSOLE_LOGS=false

# Set to 'true' to disable console colors (useful for CI/CD environments)
DISABLE_CONSOLE_COLORS=false

# Console file control mode: 'development', 'whitelist', 'blacklist', 'production-debug', 'silent'
CONSOLE_FILE_MODE=development

# File Logging Configuration
# Set to 'true' to write all logs to a file in the /logs directory
LOG_TO_FILE=false

# Portainer Configuration
PORTAINER_URL=https://your-portainer-instance.com
PORTAINER_USERNAME=admin
PORTAINER_PASSWORD=your-portainer-password
# Set to 'false' to disable SSL certificate verification (useful for self-signed certificates)
PORTAINER_REJECT_UNAUTHORIZED=false

# Port allocation
# New servers get the next free port above 25565. Besides Portainer and the database, every candidate port is
# probed on the network. These hosts are probed, comma separated. Default: 127.0.0.1 and the host of PORTAINER_URL.
PORT_CHECK_HOSTS=

# DNS for the Minecraft containers
# Set this when a container log says it cannot resolve launchermeta.mojang.com (the host's resolver is not reachable
# from inside Docker). Comma separated addresses, written into every server's compose file as `dns:`.
CONTAINER_DNS=
# 'none' removes the search domains Docker copies from the host's resolv.conf
CONTAINER_DNS_SEARCH=

# Velocity
# When a server is added or removed the manager sends "velocity reload" to the proxy console, which keeps players
# connected. That needs the proxy container to run with stdin_open: true (proxies created by the manager do).
# If the command cannot be delivered the proxy is restarted ('restart', disconnects players) or left alone ('none').
VELOCITY_RELOAD_FALLBACK=restart
# Use this velocity.toml instead of looking for one (a storage path). An existing Velocity instance is always preferred
# over creating a new one.
# VELOCITY_CONFIG_PATH=/velocity/velocity.toml

# Images used for proxies created in Admin > Proxies
# VELOCITY_IMAGE=envidtech/velocity:latest
# BUNGEE_IMAGE=itzg/mc-proxy:latest

# Folders that already hold servers or a Velocity proxy. They can be imported in Admin > Servers and are editable
# like any server. Use app=host when Docker sees the folder under another path.
# IMPORT_SCAN_PATHS=/imports=/mnt/ssd/docker

# File Storage Backend
# 'local' reads and writes server files straight on this machine, with no network hop
# (recommended when the app runs on the same host as Docker). 'webdav' uses the WebDAV server below.
# If unset: local is used when LOCAL_STORAGE_PATH is set, otherwise webdav.
STORAGE_BACKEND=local
# Absolute folder the app stores server files in (as the app sees it). Everything stays inside it.
LOCAL_STORAGE_PATH=/data/minecraft
# Only needed when the app runs in a container: the same folder as the Docker host sees it,
# used for the Minecraft containers' bind mounts. Defaults to LOCAL_STORAGE_PATH.
# LOCAL_STORAGE_HOST_PATH=/mnt/ssd/minecraft
# Optional uid:gid given to created files and folders (the itzg images run as 1000:1000).
# Needs the app to run as root, otherwise a warning is logged and files keep their owner.
# LOCAL_STORAGE_OWNER=1000:1000
# The user the Minecraft containers run as. It must be able to write the storage folder
# (use 3000 here if your storage belongs to 3000). Defaults to 1000.
# CONTAINER_UID=1000
# CONTAINER_GID=1000

# WebDAV Configuration (only used when STORAGE_BACKEND=webdav)
WEBDAV_URL=https://your-webdav-server.com
WEBDAV_USERNAME=your-webdav-username
WEBDAV_PASSWORD=your-webdav-password
# Set to 'false' to disable SSL certificate verification (useful for self-signed certificates).
# Certificates are always verified in production unless this is set to 'false'.
WEBDAV_REJECT_UNAUTHORIZED=false

# Server Folder Structure
# This is the base path where all user server folders will be created
# Structure will be: {WEBDAV_SERVER_BASE_PATH}/{username}/{unique-server-id}/
# Example: /minecraft-servers/john/686386c7fbf85b9adc878478/
WEBDAV_SERVER_BASE_PATH=/minecraft-servers

# Minecraft Server Path (WebDAV storage only; local storage uses LOCAL_STORAGE_PATH)
# This is the path where Minecraft server files will be stored
MINECRAFT_PATH=/path/to/your/minecraft-servers

# Enable/disable server folder deletion
# If set to 'true', server folders will be deleted when the server is removed
# If set to 'false', server folders will be renamed with the 'DELETED_' prefix instead of deleted
DELETE_SERVER_FOLDERS=true



# Domain every server subdomain lives under. A server named "survival" is reached at survival.<SERVER_DOMAIN>
SERVER_DOMAIN=mc.example.com

# Comma separated list of emails that become active administrators when they sign up.
# The very first account that signs up becomes an administrator automatically.
ADMIN_EMAILS=

# Secret that protects the scheduled Docker update endpoint (/api/admin/docker-updates/scheduled).
# The endpoint stays disabled while this is empty.
INTERNAL_API_KEY=

# Optional: where the proxy definitions are stored. Defaults to lib/config/proxies.yaml
# (see lib/config/proxies.example.yaml). Point it at a mounted volume when running in Docker.
PROXIES_CONFIG_PATH=
